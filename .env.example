# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/defense_semi?schema=public"

# local = existing Mock/Local Storage mode
# database = PostgreSQL + Prisma read/write mode
NEXT_PUBLIC_DATA_SOURCE="database"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"

# Production portfolio safety (recommended for public deployment)
# Production defaults to safe demo mode unless explicitly disabled.
PORTFOLIO_DEMO_MODE="true"
ADMIN_WRITE_ENABLED="false"
RFQ_WRITE_ENABLED="false"

# Client-visible label only. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_PORTFOLIO_DEMO_MODE="true"
